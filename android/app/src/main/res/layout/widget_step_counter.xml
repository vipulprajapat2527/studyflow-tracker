<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Step / Flame Icon Container with Soft Purple/Pink Background Accent -->
        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_icon_bg">

            <ImageView
                android:id="@+id/widget_step_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_directions"
                android:tint="#7000FF"
                android:contentDescription="Step Icon" />
        </FrameLayout>

        <!-- Step Count & Steps Label -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_marginStart="10dp">

            <!-- Bold Modern Dark Typography -->
            <TextView
                android:id="@+id/widget_step_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 10,000"
                android:textColor="#0F172A"
                android:textSize="19sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:gravity="center_vertical" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <!-- Colorful Meshine Brand Indicator Dot -->
                <ImageView
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="5dp"
                    android:src="@drawable/widget_brand_dot"
                    android:contentDescription="Brand Dot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Steps"
                    android:textColor="#0F172A"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:gravity="center_vertical" />
            </LinearLayout>
        </LinearLayout>

        <!-- Meshine Brand Accent Line -->
        <ImageView
            android:layout_width="22dp"
            android:layout_height="4dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="2dp"
            android:src="@drawable/widget_brand_line"
            android:contentDescription="Brand Accent" />
    </LinearLayout>

    <!-- Vibrant Meshine Gradient Progress Bar (10dp height) -->
    <ProgressBar
        android:id="@+id/widget_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:minHeight="10dp"
        android:maxHeight="10dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress_bar" />
</LinearLayout>
